    {
      "id": "ALJw5AZ_5MXW62f_Xnn3K",
      "type": "text",
      "x": 206.19688877197098,
      "y": -37.81254832521188,
      "width": 403.3756408691406,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 247353092,
      "version": 714,
      "versionNonce": 899231876,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1782498778412,
      "link": null,
      "locked": false,
      "text": "Idea 1: Rank stories by num_likes\n\nPros:\n1. Popular content gets surfaced - likely interesting\n2. Straightforward at low scale\n\nCons:\n1. New content cannot surface easily\n2. No personalization",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Idea 1: Rank stories by num_likes\n\nPros:\n1. Popular content gets surfaced - likely interesting\n2. Straightforward at low scale\n\nCons:\n1. New content cannot surface easily\n2. No personalization",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mtBrIP4hUPCe3NevRNl4Z",
      "type": "text",
      "x": 208.52515508178942,
      "y": 215.4456180513892,
      "width": 536.2554931640625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 128851772,
      "version": 1116,
      "versionNonce": 665354244,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782498778412,
      "link": null,
      "locked": false,
      "text": "Idea 2: Rank stories by num_likes and user language/country match \n\nPros:\n1. Better personalization by user cohort\n2. Low complexity\n\nCons:\n1. New content still cannot surface easily\n2. Surface-level personalization\n3. Freshness not a factor - older popular posts may dominate",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Idea 2: Rank stories by num_likes and user language/country match \n\nPros:\n1. Better personalization by user cohort\n2. Low complexity\n\nCons:\n1. New content still cannot surface easily\n2. Surface-level personalization\n3. Freshness not a factor - older popular posts may dominate",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KDysyFyrQXTHjRaZChtS-",
      "type": "text",
      "x": 217.1579260082571,
      "y": 490.87941450221115,
      "width": 681.055419921875,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 1744509700,
      "version": 1795,
      "versionNonce": 1243733892,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782498778412,
      "link": null,
      "locked": false,
      "text": "Idea 3: Introduce simple score on top\nHackerNews score = (num_likes - 1) / pow((story_age + 2), gravity), where gravity = 1.8\n\nPros:\n1. Ranking includes freshness constraints using story_age\n2. Additional heuristics beyond this while keeping complexity low \n\nCons:\n1. Still not personalized well\n\nOptimization: \nRank once during story interactions and maintain single ranked list for all\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Idea 3: Introduce simple score on top\nHackerNews score = (num_likes - 1) / pow((story_age + 2), gravity), where gravity = 1.8\n\nPros:\n1. Ranking includes freshness constraints using story_age\n2. Additional heuristics beyond this while keeping complexity low \n\nCons:\n1. Still not personalized well\n\nOptimization: \nRank once during story interactions and maintain single ranked list for all\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
