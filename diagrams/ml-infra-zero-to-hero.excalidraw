    {
      "id": "OEsFuBLf4jd1apcspdkhF",
      "type": "text",
      "x": 606.3433691185653,
      "y": 2247.780569551272,
      "width": 199.5358428955078,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
