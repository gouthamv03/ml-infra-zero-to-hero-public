    {
      "id": "JWfoJjvx_ghTCK61QouVV",
      "type": "text",
      "x": 169.09274635732447,
      "y": 1872.613831570875,
      "width": 926.8472900390625,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Y",
