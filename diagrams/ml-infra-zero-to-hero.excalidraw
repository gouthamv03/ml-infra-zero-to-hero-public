    {
      "id": "FggT64F6a9qvzdwk75yeM",
      "type": "text",
      "x": 1607.9056762672249,
      "y": 6735.9425623140305,
      "width": 73.919921875,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
