    {
      "id": "GawlwFTYFmmM-310l9JlK",
      "type": "text",
      "x": 479.6538406199785,
      "y": 5923.13935524042,
      "width": 84.5919189453125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5h",
